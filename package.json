{
  "name": "qa-personal-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first QA desktop assistant - foundation",
  "main": "dist/electron/main.js",
  "scripts": {
    "build:ui": "ng build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:ui && npm run build:electron",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron .",
    "test": "node --test tests/*.test.mjs",
    "package:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.0.0",
    "playwright": "^1.56.0",
    "rxjs": "^7.8.2",
    "zone.js": "^0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@types/node": "^22.15.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "~5.9.0"
  },
  "build": {
    "appId": "com.qa.personalagent",
    "productName": "QA Personal Agent",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/playwright/**/*",
      "node_modules/playwright-core/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
